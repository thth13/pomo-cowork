generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  username             String    @unique
  password             String
  avatarUrl            String?
  description          String?
  displayName          String?
  location             String?
  websiteUrl           String?
  githubUrl            String?
  twitterUrl           String?
  isAnonymous          Boolean   @default(false)
  isPro                Boolean   @default(false)
  proExpiresAt         DateTime?
  paddleSubscriptionId String?   @unique
  paddleCancelAt       DateTime?
  profileViews         Int       @default(0)
  experience           Int       @default(0)
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  lastStreakDate       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastSeenAt           DateTime?

  projects Project[]
  journalPosts JournalPost[]
  followers Follow[] @relation("Following")
  following Follow[] @relation("Followers")
  postReactions PostReaction[]
  journalComments JournalComment[]
  activityEvents ActivityEvent[]
  journalImages JournalImage[]

  // Settings
  workDuration   Int @default(25) // minutes
  shortBreak     Int @default(5) // minutes
  longBreak      Int @default(15) // minutes
  longBreakAfter Int @default(4) // sessions

  // Relations
  sessions PomodoroSession[]
  settings UserSettings?
  tasks    Task[]
  habits   Habit[]

  ownedRooms      Room[]       @relation("RoomOwner")
  roomMemberships RoomMember[]

  invitesSent          RoomInvite[]      @relation("RoomInviteInviter")
  invitesReceived      RoomInvite[]      @relation("RoomInviteInvitee")
  notifications        Notification[]
  supportMessages      SupportMessage[]
  chatMessages         ChatMessage[]     @relation("ChatMessages")
  referralLinks        ReferralLink[]
  referralSignups      ReferralSignup[]
  wallMessagesReceived UserWallMessage[] @relation("WallProfileUser")
  wallMessagesSent     UserWallMessage[] @relation("WallAuthorUser")

  @@map("users")
}

model ReferralLink {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String

  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  clicks    ReferralClick[]
  signups   ReferralSignup[]

  @@index([createdById])
  @@map("referral_links")
}

model ReferralClick {
  id          String   @id @default(cuid())
  referralId  String
  fingerprint String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  referral ReferralLink @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@unique([referralId, fingerprint])
  @@index([referralId, createdAt])
  @@map("referral_clicks")
}

model ReferralSignup {
  id         String   @id @default(cuid())
  referralId String
  userId     String
  createdAt  DateTime @default(now())

  referral ReferralLink @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([referralId, userId])
  @@index([referralId, createdAt])
  @@map("referral_signups")
}

enum RoomPrivacy {
  PUBLIC
  PRIVATE
}

enum RoomInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  ROOM_INVITE
  WALL_MESSAGE
  RANK_UP
}

model Room {
  id      String      @id @default(cuid())
  name    String
  privacy RoomPrivacy @default(PUBLIC)

  backgroundGradientKey String? @db.VarChar(32)

  ownerId String
  owner   User   @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members      RoomMember[]
  sessions     PomodoroSession[]
  invites      RoomInvite[]
  chatMessages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("rooms")
}

model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("room_members")
}

model RoomInvite {
  id        String           @id @default(cuid())
  roomId    String
  inviterId String
  inviteeId String
  status    RoomInviteStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter User @relation("RoomInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("RoomInviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@unique([roomId, inviteeId])
  @@index([inviteeId])
  @@index([roomId])
  @@map("room_invites")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  roomInviteId  String?
  roomInvite    RoomInvite?      @relation(fields: [roomInviteId], references: [id], onDelete: SetNull)
  wallMessageId String?
  wallMessage   UserWallMessage? @relation("WallMessageNotifications", fields: [wallMessageId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timer settings
  workDuration   Int @default(25)
  shortBreak     Int @default(5)
  longBreak      Int @default(15)
  longBreakAfter Int @default(4)

  // Sound settings
  soundEnabled Boolean @default(true)
  soundVolume  Float   @default(0.5)

  // Notification settings
  notificationsEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model Task {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title              String
  description        String  @default("")
  pomodoros          Int     @default(1) // Планируемое количество
  completedPomodoros Int     @default(0) // Фактически потраченное количество
  priority           String  @default("Средний") // "Критичный", "Высокий", "Средний", "Низкий"
  completed          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, completed, createdAt])
  @@map("tasks")
}

model Habit {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String @db.VarChar(120)
  startDate   String @db.VarChar(10)
  archived    Boolean @default(false)
  createdAt   DateTime @default(now())
  completions HabitCompletion[]

  @@index([userId, createdAt])
  @@map("habits")
}

model HabitCompletion {
  habitId String
  date    String @db.VarChar(10)
  habit   Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([habitId, date])
  @@map("habit_completions")
}

model PomodoroSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  task     String
  duration Int // in minutes
  type     String @default("WORK")
  status   String @default("ACTIVE")

  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  completedAt      DateTime?
  pausedAt         DateTime?
  remainingSeconds  Int?
  experienceAwarded Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status, completedAt])
  @@index([roomId])
  @@index([status, startedAt])
  @@index([userId, createdAt])
  @@index([userId, status, startedAt])
  @@map("pomodoro_sessions")
}

model ChatMessage {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation("ChatMessages", fields: [userId], references: [id], onDelete: SetNull)
  roomId         String?
  room           Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  username       String
  text           String
  type           String   @default("message")
  actionType     String?
  actionDuration Int?
  actionTask     String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String?
  email     String
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("support_messages")
}

model UserWallMessage {
  id            String   @id @default(cuid())
  profileUserId String
  authorId      String
  message       String
  createdAt     DateTime @default(now())

  profileUser   User           @relation("WallProfileUser", fields: [profileUserId], references: [id], onDelete: Cascade)
  author        User           @relation("WallAuthorUser", fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[] @relation("WallMessageNotifications")

  @@index([profileUserId, createdAt])
  @@index([authorId, createdAt])
  @@map("user_wall_messages")
}

enum ProjectStatus {
  PLANNING
  BUILDING
  PAUSED
  COMPLETED
  ARCHIVED
}

enum JournalVisibility {
  PUBLIC
  PRIVATE
}

enum JournalPostType {
  UPDATE
  MILESTONE
  WEEKLY_UPDATE
}

model Project {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String @db.VarChar(100)
  slug        String @db.VarChar(80)
  imageUrl    String?
  description String @default("") @db.VarChar(280)
  content     String @default("")
  status      ProjectStatus @default(PLANNING)
  visibility  JournalVisibility @default(PRIVATE)
  websiteUrl  String?
  githubUrl   String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  pinned      Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    PomodoroSession[]
  posts       JournalPost[]
  milestones  ProjectMilestone[]
  activity    ActivityEvent[]

  @@unique([userId, slug])
  @@index([userId, visibility, createdAt])
  @@map("projects")
}

model JournalPost {
  id            String @id @default(cuid())
  authorId      String
  author        User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug          String @db.VarChar(120)
  type          JournalPostType @default(UPDATE)
  title         String? @db.VarChar(160)
  content       String
  images        String[] @default([])
  important     Boolean @default(false)
  visibility    JournalVisibility @default(PRIVATE)
  showFocusStats Boolean @default(false)
  focusedSecondsSnapshot Int?
  sessionsSnapshot Int?
  statsFrom     DateTime?
  statsTo       DateTime?
  publishedAt   DateTime?
  editedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  milestone     ProjectMilestone?
  reactions     PostReaction[]
  comments      JournalComment[]
  activity      ActivityEvent[]

  @@unique([authorId, slug])
  @@index([authorId, publishedAt, id])
  @@index([projectId, publishedAt])
  @@index([visibility, publishedAt, id])
  @@map("journal_posts")
}

model ProjectMilestone {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  postId    String @unique
  post      JournalPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String @db.VarChar(160)
  description String @default("")
  type      String @default("CUSTOM") @db.VarChar(40)
  imageUrl  String?
  achievedAt DateTime
  focusedSecondsSnapshot Int
  sessionsSnapshot Int
  createdAt DateTime @default(now())

  @@index([projectId, achievedAt])
  @@map("project_milestones")
}

model Follow {
  followerId String
  followingId String
  follower User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@map("follows")
}

model PostReaction {
  userId String
  postId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post JournalPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  type String @default("SUPPORT")
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@map("post_reactions")
}

model JournalComment {
  id String @id @default(cuid())
  postId String
  authorId String
  post JournalPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content String @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt, id])
  @@index([authorId])
  @@map("journal_comments")
}

model ActivityEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  postId String?
  post JournalPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  key String
  type String
  value Int?
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, createdAt])
  @@map("activity_events")
}

// Stored in the existing PostgreSQL database so private attachments are access-controlled.
model JournalImage {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String
  data Bytes
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("journal_images")
}
